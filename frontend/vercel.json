{
  "rewrites": [
    {
      "source": "/api/feedback",
      "destination": "https://feedback-intelligence-backend.vercel.app/api/feedback/"
    },
    {
      "source": "/api/feedback/:path*",
      "destination": "https://feedback-intelligence-backend.vercel.app/api/feedback/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://feedback-intelligence-backend.vercel.app/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
